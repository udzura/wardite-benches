diff --git a/lib/wardite/efflorescence/spinel_integer.rb b/lib/wardite/efflorescence/spinel_integer.rb
--- a/lib/wardite/efflorescence/spinel_integer.rb
+++ b/lib/wardite/efflorescence/spinel_integer.rb
@@ -13,6 +13,30 @@
 
       ffi_source <<~C
         #include <stdint.h>
+
+        int wardite_check_mir_run(const int64_t *code, size_t length, size_t pc, size_t registers,
+                                  const char *rules, size_t nrules, int memory) {
+          for (; pc < length; pc += 4) {
+            if (length-pc < 4 || (uint64_t)code[pc] >= nrules) return -1;
+            unsigned rule = (unsigned char)rules[code[pc]];
+            if ((rule >> 3) == 0) break;
+            for (unsigned i=0; i<3; ++i)
+              if ((rule & (1u << i)) && (uint64_t)code[pc+i+1] >= registers) return -1;
+            uint64_t c = (uint64_t)code[pc+3];
+            switch (rule >> 3) {
+              case 2: case 3: {
+                uint64_t target = (uint64_t)code[pc+((rule >> 3)==2 ? 1 : 2)];
+                if (target >= length || target % 4) return -1;
+                break;
+              }
+              case 4: if (!memory) return -1; /* fall through */
+              case 5: if (c > UINT32_MAX) return -1; break;
+              case 6: if (c > ((uint64_t)UINT32_MAX << 6 | 63)) return -1; break;
+              case 7: if (c > 31) return -1; break;
+            }
+          }
+          return (int)pc;
+        }
 
         int64_t wardite_i64_shl(int64_t bits, int64_t count) {
           return (int64_t)((uint64_t)bits << ((uint64_t)count & 63));
@@ -33,6 +57,7 @@
           return (int)((byte << 8) | bytes[index]);
         }
