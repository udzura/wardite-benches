diff --git a/lib/wardite/efflorescence/spinel_integer.rb b/lib/wardite/efflorescence/spinel_integer.rb
--- a/lib/wardite/efflorescence/spinel_integer.rb
+++ b/lib/wardite/efflorescence/spinel_integer.rb
@@ -13,6 +13,35 @@
 
       ffi_source <<~C
         #include <stdint.h>
+
+        static int wardite_leb32(const unsigned char *b, size_t size, size_t *pos, int sign, uint32_t *out) {
+          uint32_t value = 0;
+          for (unsigned i = 0; i < 5 && *pos < size; ++i) {
+            uint32_t c = b[(*pos)++];
+            if (i == 4 && (sign ? ((c & 0x78) != 0 && (c & 0x78) != 0x78) : (c & 0x70) != 0)) return 0;
+            value |= (c & 127) << (7*i);
+            if (c & 128) continue;
+            if (sign && i < 4 && (c & 64)) value |= UINT32_MAX << (7*(i+1));
+            *out = value; return 1;
+          }
+          return 0;
+        }
+
+        int wardite_data_segments(const char *payload, size_t size, size_t pos, void *result, size_t count) {
+          const unsigned char *b = (const unsigned char *)payload;
+          unsigned char *dir = (unsigned char *)result;
+          for (size_t i = 0; i < count; ++i) {
+            uint32_t offset, length;
+            if (pos > size || size - pos < 2 || b[pos++] != 0 || b[pos++] != 0x41 ||
+                !wardite_leb32(b,size,&pos,1,&offset) || pos >= size || b[pos++] != 0x0b ||
+                !wardite_leb32(b,size,&pos,0,&length) || length > size-pos) return 0;
+            uint32_t words[] = {offset,(uint32_t)pos,length};
+            for (int j=0; j<3; ++j)
+              for (int k=0; k<4; ++k) dir[12*i+4*j+k] = (unsigned char)(words[j] >> (8*k));
+            pos += length;
+          }
+          return pos == size;
+        }
 
         int64_t wardite_i64_shl(int64_t bits, int64_t count) {
           return (int64_t)((uint64_t)bits << ((uint64_t)count & 63));
