diff --git a/lib/wardite/efflorescence/spinel_integer.rb b/lib/wardite/efflorescence/spinel_integer.rb
--- a/lib/wardite/efflorescence/spinel_integer.rb
+++ b/lib/wardite/efflorescence/spinel_integer.rb
@@ -13,6 +13,18 @@
 
       ffi_source <<~C
         #include <stdint.h>
+        #include <string.h>
+
+        int wardite_copy_snapshot_pages(void *memory, size_t size, const char *payload, size_t length,
+                                        size_t offset, const int64_t *used, size_t count) {
+          const size_t page = 65536;
+          if (offset > length || (length - offset) % page || count != (length - offset) / page) return 0;
+          for (size_t i = 0; i < count; ++i)
+            if (used[i] < 0 || (uint64_t)used[i] >= size / page) return 0;
+          for (size_t i = 0; i < count; ++i)
+            memcpy((char *)memory + (size_t)used[i] * page, payload + offset + i * page, page);
+          return 1;
+        }
 
         int64_t wardite_i64_shl(int64_t bits, int64_t count) {
           return (int64_t)((uint64_t)bits << ((uint64_t)count & 63));
@@ -33,6 +45,7 @@
           return (int)((byte << 8) | bytes[index]);
         }
       C
+      ffi_func :wardite_copy_snapshot_pages, [:buffer_inout, :size_t, :binstr, :size_t, :size_t, :int_array, :size_t], :int
