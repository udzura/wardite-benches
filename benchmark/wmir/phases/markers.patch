@@ -1,6 +1,75 @@
 # frozen_string_literal: true
 # rbs_inline: enabled
 
+# Spinel-only benchmark overlay. Times share CLOCK_MONOTONIC with the parent.
+module StartupProbe
+  OPEN = 1
+  INPUT = 2
+  KEY = 3
+  SECTIONS = 4
+  MIR_READ = 5
+  MIR_VERIFY = 6
+  DECLARE = 7
+  INSTANCE = 8
+  LINK = 9
+  SNAP_KEY = 10
+  SNAP_READ = 11
+  SNAP_SLICE = 12
+  SNAP_HASH = 13
+  SNAP_VALIDATE = 14
+  SNAP_GROW = 15
+  SNAP_COPY = 16
+  SNAP_ZERO = 17
+  SNAP_GLOBALS = 18
+  FRAMES = 19
+  GUEST = 20
+  LAZY_BEGIN = 97
+  LAZY_END = 98
+  FINISH = 99
+  ffi_source <<~C
+    #include <time.h>
+    #include <stdio.h>
+    static const char *names[21] = {0, "open", "input", "key", "sections", "mir_read", "mir_verify", "declare", "instance", "link", "snap_key", "snap_read", "snap_slice", "snap_hash", "snap_validate", "snap_grow", "snap_copy", "snap_zero", "snap_globals", "frames", "guest"};
+    static unsigned long long first, last, lazy_start, elapsed[21],
+      lazy[21], calls[21];
+    static int phase, done, initial_pages, pages, used;
+    int startup_probe_memory(int initial, int total, int nonzero) {
+      initial_pages = initial;
+      pages = total;
+      used = nonzero;
+      return 0;
+    }
+    int startup_probe_mark(int event) {
+      if (done) return 0;
+      struct timespec ts;
+      clock_gettime(CLOCK_MONOTONIC, &ts);
+      unsigned long long now = (unsigned long long)ts.tv_sec * 1000000000 + ts.tv_nsec;
+      if (event == 97) {
+        lazy_start = now;
+        return 0;
+      }
+      if (event == 98) {
+        lazy[phase] += now - lazy_start;
+        calls[phase]++;
+        return 0;
+      }
+      if (phase) elapsed[phase] += now - last;
+      else first = now;
+      last = now;
+      if (event == 99) {
+        done = 1;
+        fprintf(stderr, "WMIR_PHASE_NS %llu %llu %d %d %d", first, now, initial_pages, pages, used);
+        for (size_t i = 1; i < 21; i++)
+          fprintf(stderr, " %s=%llu/%llu/%llu", names[i], elapsed[i], lazy[i], calls[i]);
+        fputc(10, stderr);
+      } else phase = event;
+      return 0;
+    }
+  C
+  ffi_func :startup_probe_mark, [:int], :int
+  ffi_func :startup_probe_memory, [:int, :int, :int], :int
+end
+
 require_relative "wardite/version"
 require_relative "wardite/leb128"
 require_relative "wardite/const"
