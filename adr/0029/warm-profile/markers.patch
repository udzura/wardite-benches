+
+# Benchmark-only monotonic timestamps. Emit one record after the guest has run.
+module StartupProbe
+  READ_WASM = 1
+  MIR_KEY = 2
+  WASM_SECTIONS = 3
+  MIR_READ = 4
+  INSTANCE = 5
+  SNAPSHOT = 6
+  REBUILD_FRAMES = 7
+  RUN_FRAMES = 8
+  FINISHED = 9
+  LAZY_BEGIN = 10
+  LAZY_END = 11
+  ffi_source <<~C
+    #include <time.h>
+    #include <stdio.h>
+    static unsigned long long stamp[10], lazy_ns[10], lazy_calls[10], lazy_start;
+    static int stage;
+    int startup_probe_mark(int event) {
+      struct timespec ts;
+      clock_gettime(CLOCK_MONOTONIC, &ts);
+      unsigned long long now = (unsigned long long)ts.tv_sec * 1000000000 + ts.tv_nsec;
+      if (event == 10) {
+        lazy_start = now;
+      } else if (event == 11) {
+        lazy_ns[stage] += now - lazy_start;
+        lazy_calls[stage]++;
+      } else if (stage != 9) {
+        stage = event;
+        stamp[stage] = now;
+        if (stage == 9) {
+          fprintf(stderr, "WARDITE_STARTUP_NS");
+          for (int i = 1; i <= 9; i++) {
+            fprintf(stderr, " %llu/%llu/%llu", stamp[i], lazy_ns[i], lazy_calls[i]);
+          }
+          fputc(10, stderr);
+        }
+      }
+      return 0;
+    }
+  C
+  ffi_func :startup_probe_mark, [:int], :int
+end
 
