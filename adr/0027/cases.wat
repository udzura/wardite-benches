(module
  (memory 1)
  ;; Repeat a mask twice in each iteration. Return its contribution twice.
  (func (export "loop") (param $n i32) (result i32) (local $sum i32)
    (block $done (loop $again
      (br_if $done (i32.eqz (local.get $n)))
      (local.set $sum (i32.add (local.get $sum)
        (i32.add (i32.and (local.get $n) (i32.const 255))
                 (i32.and (local.get $n) (i32.const 255)))))
      (local.set $n (i32.sub (local.get $n) (i32.const 1)))
      (br $again)))
    (local.get $sum))
  (func (export "input") (param $x i32) (result i32) (local $first i32)
    (local.set $first (i32.and (local.get $x) (i32.const 255)))
    (local.set $x (i32.add (local.get $x) (i32.const 1)))
    (i32.sub (local.get $first) (i32.and (local.get $x) (i32.const 255))))
  (func (export "result") (param $x i32) (result i32) (local $first i32)
    (local.set $first (i32.and (local.get $x) (i32.const 255)))
    (local.set $first (i32.const 71))
    (i32.add (local.get $first) (i32.and (local.get $x) (i32.const 255))))
  (func (export "join") (param $x i32) (result i32) (local $v i32)
    (local.set $v (i32.and (local.get $x) (i32.const 255)))
    (if (i32.and (local.get $x) (i32.const 1))
      (then (local.set $x (i32.const 514))))
    (i32.add (local.get $v) (i32.and (local.get $x) (i32.const 255))))
  (func (export "escape") (param $x i32) (result i32) (local $a i32) (local $b i32)
    (local.set $a (i32.and (local.get $x) (i32.const 255)))
    (local.set $b (i32.and (local.get $x) (i32.const 255)))
    (if (local.get $x) (then (local.set $a (i32.const 3))))
    (i32.add (local.get $a) (local.get $b)))
  (func (export "side") (param $x i32) (result i32) (local $v i32)
    (local.set $v (i32.and (local.get $x) (i32.const 255)))
    (memory.fill (i32.const 0) (i32.and (local.get $x) (i32.const 255)) (i32.const 1))
    (i32.add (i32.load8_u (i32.const 0)) (local.get $v)))
  (func (export "wide") (param $x i64) (result i32)
    (i32.wrap_i64 (i64.add (i64.xor (local.get $x) (i64.const 4294967297))
                           (i64.xor (i64.const 4294967297) (local.get $x)))))
  (func (export "divide") (param $x i32) (result i32)
    (i32.add (i32.div_u (i32.const 42) (local.get $x))
             (i32.div_u (i32.const 42) (local.get $x)))))
