#!/usr/bin/env python3

import base64
import json
import struct
import zlib
from pathlib import Path


def png_chunk(kind, payload):
    return struct.pack(">I", len(payload)) + kind + payload + struct.pack(">I", zlib.crc32(kind + payload))


def rgb_png(size):
    scanlines = bytearray()
    for y in range(size):
        scanlines.append(1)  # PNG Sub filter
        previous = (0, 0, 0)
        for x in range(size):
            pixel = (x & 255, y & 255, (x ^ y) & 255)
            scanlines.extend((value - left) & 255 for value, left in zip(pixel, previous))
            previous = pixel

    header = struct.pack(">IIBBBBB", size, size, 8, 2, 0, 0, 0)
    return (
        b"\x89PNG\r\n\x1a\n"
        + png_chunk(b"IHDR", header)
        + png_chunk(b"IDAT", zlib.compress(scanlines))
        + png_chunk(b"IEND", b"")
    )


def access_log(count):
    paths = ["/", "/api/items", "/検索/商品", "/記事/バックナンバー"]
    statuses = [200, 200, 304, 404, 200, 503, 201, 500, 200, 200, 204]
    rows = []
    for i in range(count):
        row = {
            "status": statuses[i % len(statuses)],
            "bytes": (8191 * i + 17) % 65536,
            "path": f"{paths[i % len(paths)]}/{i}" if i % len(paths) else "/",
        }
        rows.append(json.dumps(row, ensure_ascii=i % 4 == 3, separators=(",", ":")))
    return "[\n" + ",\n".join(rows) + "\n]\n"


def rss_feed(count):
    titles = ["Ruby news", "更新 &amp; 解説", "Wasm &#x1F4DA;", "<![CDATA[Ruby <tips>]]>"]
    items = (f"<item><title>{titles[i % len(titles)]} {i}</title></item>" for i in range(count))
    return (
        '<rss version="2.0"><channel><title>Wardite</title>'
        '<link>https://example.org/</link><description>News</description>\n'
        + "\n".join(items)
        + "\n</channel></rss>\n"
    )


def main():
    directory = Path(__file__).resolve().parents[1] / "build" / "fixtures"
    directory.mkdir(parents=True, exist_ok=True)
    for count in (1024, 16384):
        (directory / f"feed-{count}.xml").write_text(rss_feed(count), encoding="utf-8")
        (directory / f"access-{count}.json").write_text(access_log(count), encoding="utf-8")
    data = bytes(range(256)) * 1024 + b"\xff"
    (directory / "data.bin").write_bytes(data)
    (directory / "data.b64").write_bytes(base64.b64encode(data) + b"\n")
    (directory / "rgb.png").write_bytes(rgb_png(256))
    # 16 times the default inputs, so the transform outweighs start-up.
    large = data * 16
    (directory / "data-4m.bin").write_bytes(large)
    (directory / "data-4m.b64").write_bytes(base64.b64encode(large) + b"\n")
    (directory / "rgb-1024.png").write_bytes(rgb_png(1024))
    (directory / "empty").write_bytes(b"")


if __name__ == "__main__":
    main()
