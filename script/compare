#!/usr/bin/env python3

import argparse
import hashlib
import math
import os
import re
import shlex
import struct
import subprocess
import sys
from pathlib import Path


def invoke(engine, command, *, stdin=None):
    try:
        result = subprocess.run(command, stdin=stdin, capture_output=True, text=stdin is None, check=True)
    except OSError as error:
        raise ValueError(f"Could not start {engine}: {error}") from error
    except subprocess.CalledProcessError as error:
        detail = error.stderr.strip() or error.stdout.strip()
        if isinstance(detail, bytes):
            detail = detail.decode(errors="replace")
        raise ValueError(f"{engine} failed (exit {error.returncode})\n{detail}") from error
    return result


def numeric_bits(kind, value):
    if kind.startswith("I"):
        return int(value, 0) % (1 << int(kind[1:]))

    number = float(value)
    if math.isnan(number):
        return None
    return struct.pack(">f" if kind == "F32" else ">d", number)


def compare_iwasm(kind, reference, output):
    match = re.fullmatch(r"(\S+):([if](?:32|64))", output)
    if match is None or match[2].upper() != kind:
        raise ValueError(f"Expected one {kind} result from iwasm.\n{output}")

    value = match[1]
    try:
        if numeric_bits(kind, reference) == numeric_bits(kind, value):
            return True
        if kind.startswith("I"):
            return False

        number = float(reference)
        if kind == "F32":
            number = struct.unpack(">f", struct.pack(">f", number))[0]
        # iwasm prints both float widths with %.7g.
        return numeric_bits("F64", format(number, ".7g")) == numeric_bits("F64", value)
    except (ValueError, OverflowError, struct.error) as error:
        raise ValueError(f"Could not read the {kind} result from iwasm.\n{output}") from error


def benchmark(commands, input_path=None):
    command = ["hyperfine", "--shell=none", "--warmup", "2", "--runs", "5"]
    if input_path is not None:
        command.extend(["--input", str(input_path)])
    for name, args in commands.items():
        command.extend(["--command-name", name, shlex.join(args)])
    try:
        result = subprocess.run(command)
    except OSError as error:
        print(f"Could not start hyperfine: {error}", file=sys.stderr)
        return 2
    return 0 if result.returncode == 0 else 2


def compare_wasi(options, run, guest_args):
    wasm = str(Path(options.wasm).absolute())
    commands = {
        "Wardite": [*run, "--", wasm, *guest_args],
        "Wasmtime": ["wasmtime", "run", "--", wasm, *guest_args],
    }
    if options.iwasm:
        commands["iwasm --interp"] = ["iwasm", "--interp", wasm, *guest_args]

    outputs = []
    with options.wasi_stdin.open("rb") as source:
        for name, command in commands.items():
            source.seek(0)
            output = invoke(name, command, stdin=source).stdout
            outputs.append(output)
            print(f"{name}  {len(output)} bytes  SHA-256 {hashlib.sha256(output).hexdigest()}")

    agrees = all(output == outputs[0] for output in outputs[1:])
    print("Match" if agrees else "Mismatch", flush=True)
    if agrees and options.bench:
        return benchmark(commands, options.wasi_stdin.absolute())
    return 0 if agrees else 1


def main():
    parser = argparse.ArgumentParser(
        description="Compare a numeric Wasm export or a WASI command across engines."
    )
    parser.add_argument(
        "--bench", action="store_true", help="benchmark the engines with hyperfine after a match"
    )
    parser.add_argument("--iwasm", action="store_true", help="include iwasm in interpreter mode")
    parser.add_argument(
        "--wasi-stdin", type=Path, metavar="FILE", help="run a WASI command with FILE on stdin and compare stdout"
    )
    parser.add_argument("wasm", metavar="WASM")
    parser.add_argument("entry", nargs="?", metavar="EXPORT_OR_ARG")
    parser.add_argument("args", nargs=argparse.REMAINDER, metavar="ARG")
    options = parser.parse_args()

    # Launch the binary itself: script/run would add a shell start-up to every timing.
    wardite = Path(__file__).resolve().parents[1] / "build" / "wardite"
    if not os.access(wardite, os.X_OK):
        print("Wardite is missing. Run script/build first.", file=sys.stderr)
        return 2
    run = [str(wardite), "--new-engine"]
    if options.wasi_stdin is not None:
        guest_args = options.args if options.entry is None else [options.entry, *options.args]
        try:
            return compare_wasi(options, run, guest_args)
        except (OSError, ValueError) as error:
            print(error, file=sys.stderr)
            return 2
    if options.entry is None:
        parser.error("EXPORT is required for a numeric comparison")

    args = ["--invoke", options.entry, "--", options.wasm, *options.args]
    commands = {
        "Wardite": [*run, "--no-wasi", *args],
        "Wasmtime": ["wasmtime", "run", *args],
    }
    if options.iwasm:
        wasm = str(Path(options.wasm).absolute())
        commands["iwasm --interp"] = [
            "iwasm", "--interp", "-f", options.entry, wasm, *options.args
        ]
    try:
        wardite = invoke("Wardite", commands["Wardite"])
        match = re.search(r"^return value: ([IF](?:32|64))\(([^\n]+)\)$", wardite.stderr, re.M)
        if match is None:
            raise ValueError(f"Expected one numeric result from Wardite.\n{wardite.stderr.strip()}")
        kind, wardite_value = match.groups()

        wasmtime = invoke("Wasmtime", commands["Wasmtime"])
        wasmtime_value = wasmtime.stdout.strip()
        try:
            agrees = numeric_bits(kind, wardite_value) == numeric_bits(kind, wasmtime_value)
        except (ValueError, OverflowError, struct.error) as error:
            raise ValueError(
                f"Expected one {kind} result from each engine.\n"
                f"Wardite: {wardite_value!r}\nWasmtime: {wasmtime_value!r}"
            ) from error

        if options.iwasm:
            iwasm = invoke("iwasm --interp", commands["iwasm --interp"])
            iwasm_output = iwasm.stdout.strip()
            iwasm_agrees = compare_iwasm(kind, wardite_value, iwasm_output)
            agrees = agrees and iwasm_agrees
    except ValueError as error:
        print(error, file=sys.stderr)
        return 2

    print(f"Wardite  {kind}({wardite_value})")
    print(f"Wasmtime {kind}({wasmtime_value})")
    if options.iwasm:
        print(f"iwasm --interp {iwasm_output}")
    status = "Match" if agrees else "Mismatch"
    if options.iwasm and kind.startswith("F"):
        status += " (iwasm floats compared at 7 significant digits)"
    print(status, flush=True)
    if agrees and options.bench:
        return benchmark(commands)
    return 0 if agrees else 1


if __name__ == "__main__":
    sys.exit(main())
